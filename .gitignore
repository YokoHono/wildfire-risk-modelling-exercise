Forest/*
Prairie/*
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo

# Local virtualenv from install_packages.sh
.venv/
install.log

# Files regenerated by src/data_sources.py from cached *.zip archives.
# We track only the (smaller) zips in LFS and re-extract on first use.
data_cache/mtbs_perimeters/mtbs_perims_DD.*
data_cache/wui/*/[A-Z][A-Z]_wui_block_1990_2020_change_v4/
data_cache/fpa_fod/*.sqlite
data_cache/fpa_fod/*.gpkg

# Voxel 2-D summaries regenerated by src/canopy.py from the synthetic
# Forest/Prairie voxel .dat files.
data_cache/*_voxel_summary.npz

# ArcGIS-trimmed deliverables — derived from <scenario>_risk_scored_5component
# by make_arcgis_outputs.py. Cheap to regenerate; not worth LFS storage.
outputs/*_risk_arcgis.geojson

# Folium HTML maps — regenerated by src/viz.py (make_risk_map /
# make_components_map) from <scenario>_risk_scored_5component.geojson.
# The notebook re-renders them on every run.
outputs/*_risk_map.html
outputs/*_risk_components.html

# Per-property OroraTech sim ignitions — regenerated by
# extract_property_ignitions.py from the HTML viewer in the same folder.
data_cache/fire_spread_simulations/*/forecast_*_properties.geojson
